14:["$","nav",null,{"className":"case-contents shell","aria-label":"Case study chapters","children":[["$","span",null,{"children":"In this case study"}],["$","ol",null,{"children":[["$","li","context",{"children":["$","a",null,{"href":"#context","children":[["$","span",null,{"children":"01"}],"The context"]}]}],["$","li","understanding",{"children":["$","a",null,{"href":"#understanding","children":[["$","span",null,{"children":"02"}],"Understanding the user"]}]}],["$","li","architecture",{"children":["$","a",null,{"href":"#architecture","children":[["$","span",null,{"children":"03"}],"Information architecture"]}]}],["$","li","process",{"children":["$","a",null,{"href":"#process","children":[["$","span",null,{"children":"04"}],"The design process"]}]}],["$","li","outcome",{"children":["$","a",null,{"href":"#outcome","children":[["$","span",null,{"children":"05"}],"Outcome"]}]}]]}]]}]
15:["$","section","context",{"className":"case-story-section","id":"context","children":["$","div",null,{"className":"shell case-story-grid","children":[["$","header",null,{"className":"case-chapter-heading","children":[["$","p",null,{"className":"eyebrow","children":["<",["01"," / ","The context"],">"]}],["$","h2",null,{"children":["A respected institution with a legacy website",["$","span",null,{"className":"red-square","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"case-body","children":["$undefined",[["$","p","The Institute of Health and Nursing Australia (IHNA) stands as one of Australia's premier providers of nursing and healthcare education. With a mandate to shape the careers of thousands of students annually, they play a critical role in supplying the national healthcare workforce with qualified professionals.",{"children":"The Institute of Health and Nursing Australia (IHNA) stands as one of Australia's premier providers of nursing and healthcare education. With a mandate to shape the careers of thousands of students annually, they play a critical role in supplying the national healthcare workforce with qualified professionals."}],["$","p","While their academic reputation was top-tier, their digital presence lagged significantly behind modern standards. The existing website suffered from systemic issues that hindered student acquisition.",{"children":"While their academic reputation was top-tier, their digital presence lagged significantly behind modern standards. The existing website suffered from systemic issues that hindered student acquisition."}]],["$","div",null,{"className":"case-source-points","children":[["$","article","Information Overload",{"children":[["$","h3",null,{"children":"Information Overload"}],["$","p",null,{"children":"Prospective students struggled to find specific course details amidst a sea of unstructured content. Critical information was often buried within dense text blocks or detached PDFs, creating a high cognitive load."}]]}],["$","article","Fragmented Branding",{"children":[["$","h3",null,{"children":"Fragmented Branding"}],["$","p",null,{"children":"Over years of rapid campus expansion and program additions, the visual identity had become inconsistent. Disparate portals and landing pages used varying fonts, colors, and layouts, eroding brand trust and recognition."}]]}],["$","article","Navigation Friction",{"children":[["$","h3",null,{"children":"Navigation Friction"}],["$","p",null,{"children":"The user pathway to Apply was convoluted and non-linear. This friction in the conversion funnel led to measurable drop-offs, as interested applicants abandoned the process due to complexity."}]]}],["$","article","The Mission",{"children":[["$","h3",null,{"children":"The Mission"}],["$","p",null,{"children":"The objective was twofold: to completely redesign the core website for immediate usability improvements and to build a robust, modular Design System to future-proof the brand and streamline subsequent digital development."}]]}]]}],["$","div",null,{"className":"case-source-visuals case-source-visuals-1","children":[["$","figure","ihna-previous-design",{"className":"case-visual-ihna-previous-design","children":[["$","img",null,{"className":"case-real-screen","src":"/assets/case-studies/ihna/previous-design.png","alt":"Previous IHNA Australia website, shown as a long page collage of its homepage, course listings, student features, and footer.","width":"1440","height":"900","loading":"lazy"}],["$","figcaption",null,{"children":"Previous design"}]]}]]}]]}]]}]}]
16:["$","section","understanding",{"className":"case-story-section dark","id":"understanding","children":["$","div",null,{"className":"shell case-story-grid","children":[["$","header",null,{"className":"case-chapter-heading","children":[["$","p",null,{"className":"eyebrow","children":["<",["02"," / ","Understanding the user"],">"]}],["$","h2",null,{"children":["Two audiences, two sets of needs",["$","span",null,{"className":"red-square","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"case-body","children":[["$","blockquote",null,{"className":"case-source-quote","children":"We moved beyond assumptions to ground our design strategy in empirical data. Through extensive user surveys, stakeholder interviews, and a rigorous competitive analysis of other TAFEs and RTOs, clear behavioral patterns emerged."}],"$undefined",["$","div",null,{"className":"case-source-points","children":[["$","article","Key Insight 1: The Two-Audience Dilemma",{"children":[["$","h3",null,{"children":"Key Insight 1: The Two-Audience Dilemma"}],["$","p",null,{"children":"Domestic and International students possess vastly different informational needs. International students prioritize CRICOS codes, visa compliance, and English language requirements, whereas domestic students focus on VET Student Loans and local campus proximity. The legacy site conflated these datasets. We needed a mechanism to segment the experience instantaneously without managing two separate websites."}]]}],["$","article","Key Insight 2: The Course vs. Career Gap",{"children":[["$","h3",null,{"children":"Key Insight 2: The Course vs. Career Gap"}],["$","p",null,{"children":"Students are not merely shopping for courses or qualifications; they are investing in career outcomes. Users search based on their ambition rather than the specific academic title. The search functionality and content hierarchy needed to bridge academic offerings and industry job roles."}]]}]]}],["$","div",null,{"className":"case-source-visuals case-source-visuals-1","children":[["$","figure","ihna-student-story",{"className":"case-visual-ihna-student-story","children":[["$","img",null,{"className":"case-real-screen","src":"/assets/case-studies/ihna/student-story.webp","alt":"Two students sitting together against an orange wall.","width":"1440","height":"900","loading":"lazy"}],"$undefined"]}]]}]]}]]}]}]
17:["$","section","architecture",{"className":"case-story-section","id":"architecture","children":["$","div",null,{"className":"shell case-story-grid","children":[["$","header",null,{"className":"case-chapter-heading","children":[["$","p",null,{"className":"eyebrow","children":["<",["03"," / ","Information architecture"],">"]}],["$","h2",null,{"children":["Rules for the digital ecosystem",["$","span",null,{"className":"red-square","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"case-body","children":[["$","blockquote",null,{"className":"case-source-quote","children":"Before creating individual page layouts, I established the governing rules for the digital ecosystem."}],"$undefined",["$","div",null,{"className":"case-source-points","children":[["$","article","The Design System",{"children":[["$","h3",null,{"children":"The Design System"}],["$","p",null,{"children":"To resolve the fragmented branding issue, I established a centralized, atomic Design System. I standardized interface components from buttons and form fields to navigation bars and card layouts, and re-engineered the color palette and typography hierarchy to adhere to WCAG contrast ratios."}]]}],["$","article","Information Architecture",{"children":[["$","h3",null,{"children":"Information Architecture"}],["$","p",null,{"children":"I completely overhauled the sitemap, moving from an organization-centric structure to a user-centric one, significantly reducing the click-depth required to reach a Course Detail page."}]]}],["$","article","Banner Navigation",{"children":[["$","h3",null,{"children":"Banner Navigation"}],["$","p",null,{"children":"We elevated the primary navigation by moving course categories directly into the hero banner. By placing this interaction above the fold, we aligned the interface with the primary user goal: finding a course."}]]}]]}],["$","div",null,{"className":"case-source-visuals case-source-visuals-3","children":[["$","figure","ihna-system-a",{"className":"case-visual-ihna-system-a","children":[["$","img",null,{"className":"case-real-screen","src":"/assets/case-studies/ihna/system-a.webp","alt":"IHNA digital experience design visual.","width":"1440","height":"900","loading":"lazy"}],"$undefined"]}],["$","figure","ihna-system-b",{"className":"case-visual-ihna-system-b","children":[["$","img",null,{"className":"case-real-screen","src":"/assets/case-studies/ihna/system-b.webp","alt":"IHNA website design visual.","width":"1440","height":"900","loading":"lazy"}],"$undefined"]}],["$","figure","ihna-system-c",{"className":"case-visual-ihna-system-c","children":[["$","img",null,{"className":"case-real-screen","src":"/assets/case-studies/ihna/system-c.webp","alt":"IHNA modular website interface screens.","width":"1440","height":"900","loading":"lazy"}],"$undefined"]}]]}]]}]]}]}]
18:["$","section","process",{"className":"case-story-section dark","id":"process","children":["$","div",null,{"className":"shell case-story-grid","children":[["$","header",null,{"className":"case-chapter-heading","children":[["$","p",null,{"className":"eyebrow","children":["<",["04"," / ","The design process"],">"]}],["$","h2",null,{"children":["Functional intelligence over decoration",["$","span",null,{"className":"red-square","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"case-body","children":[["$","blockquote",null,{"className":"case-source-quote","children":"The final design prioritized functional intelligence over purely aesthetic upgrades. Based on the specific objectives defined during the research phase, we implemented high-impact features designed to reduce friction."}],"$undefined","$undefined",["$","div",null,{"className":"case-source-visuals case-source-visuals-1","children":[["$","figure","ihna-experience",{"className":"case-visual-ihna-experience","children":[["$","img",null,{"className":"case-real-screen","src":"/assets/case-studies/ihna/experience.avif","alt":"An editorial interior image used in the IHNA experience direction.","width":"1440","height":"900","loading":"lazy"}],"$undefined"]}]]}]]}]]}]}]
19:["$","section","outcome",{"className":"case-story-section","id":"outcome","children":["$","div",null,{"className":"shell case-story-grid","children":[["$","header",null,{"className":"case-chapter-heading","children":[["$","p",null,{"className":"eyebrow","children":["<",["05"," / ","Outcome"],">"]}],["$","h2",null,{"children":["A student recruitment engine",["$","span",null,{"className":"red-square","aria-hidden":"true"}]]}]]}],["$","div",null,{"className":"case-body","children":["$undefined",[["$","p","The redesign successfully transformed IHNA's digital face from a static, legacy repository into a dynamic, user-centered student recruitment engine.",{"children":"The redesign successfully transformed IHNA's digital face from a static, legacy repository into a dynamic, user-centered student recruitment engine."}]],["$","div",null,{"className":"case-source-points","children":[["$","article","Brand Cohesion",{"children":[["$","h3",null,{"children":"Brand Cohesion"}],["$","p",null,{"children":"The new Design System created a single source of truth for the brand, streamlining internal development workflows and helping future pages launch faster with visual consistency."}]]}],["$","article","Enhanced Usability",{"children":[["$","h3",null,{"children":"Enhanced Usability"}],["$","p",null,{"children":"The Audience Toggle and Floating Tabs directly addressed navigation difficulty. Qualitative feedback indicated less information clutter and improved time-on-task for course discovery."}]]}],["$","article","Future-Ready Scalability",{"children":[["$","h3",null,{"children":"Future-Ready Scalability"}],["$","p",null,{"children":"The modular architecture can accommodate new course verticals, campus locations, and regulatory requirements without a foundational rebuild or a broken user experience."}]]}]]}],"$undefined"]}]]}]}]
